cabal-version:      3.0
name:               Lab2-FP
version:            0.1.0.0
build-type:         Simple

common shared-properties
    build-depends:      base >=4.14 && <5
    default-language:   Haskell2010
    ghc-options:
        -Wall
        -O2

library
    import:             shared-properties
    build-depends:      parallel
    hs-source-dirs:     src
    exposed-modules:    GaussianSolver

executable lab2-fp-exe
    import:             shared-properties
    main-is:            Main.hs
    build-depends:
        , Lab2-FP
        , text
    hs-source-dirs:     app
    ghc-options:
        -threaded
        -rtsopts
        "-with-rtsopts=-N"

test-suite lab2-fp-test
    import:             shared-properties
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
        , Lab2-FP
        , hspec
        , time     
        , deepseq  
        , text      
    ghc-options:
        -threaded
        -rtsopts
        "-with-rtsopts=-N"
